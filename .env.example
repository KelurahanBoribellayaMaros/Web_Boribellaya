# Firebase client config (Project Settings -> General -> Your apps -> Web app)
# These are NOT secret - Firebase's web config is meant to be public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK service account (Project Settings -> Service Accounts -> Generate new private key)
# These ARE secret - never commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use FIREBASE_PRIVATE_KEY for local dev (raw PEM string, \n-escaped is fine).
# On Vercel (or any host whose UI can mangle multi-line values), set
# FIREBASE_PRIVATE_KEY_BASE64 instead - a base64 string has no newlines or
# special characters, so it can't be corrupted by a bulk ".env paste" import.
# Generate it locally with:
#   node --env-file=.env.local -e "console.log(Buffer.from(process.env.FIREBASE_PRIVATE_KEY.replace(/\\n/g,'\n'),'utf-8').toString('base64'))"
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_BASE64=

# Supabase (Project Settings -> API)
# The URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is SECRET - server-only, bypasses Row Level Security. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP - used to email admins when a citizen submits a new permohonan.
# 1. Enable 2-Step Verification on the sending Gmail account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password below (NOT the regular Gmail password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: absolute site URL used to build the "view request" link in
# admin notification emails. Falls back to Vercel's own VERCEL_URL, then
# to http://localhost:3000 for local dev, so this is only needed if you
# want the email link to point at a custom domain.
SITE_URL=
